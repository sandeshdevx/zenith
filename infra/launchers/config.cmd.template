@echo off
rem Zenith runtime config — generated by install-windows.bat.
rem Sets ZENITH_ROOT (project directory) and loads .env values.
rem DO NOT edit manually — re-run install-windows.bat to regenerate.

set "ZENITH_ROOT=%%ZENITH_ROOT_PLACEHOLDER%%"

rem ── Load .env ────────────────────────────────────────────────────────────────
rem Parse key=value pairs from the project .env file (ignores # comments).
for /f "usebackq tokens=1,* delims==" %%A in (
    `findstr /v "^#" "%ZENITH_ROOT%\.env" 2^>nul`
) do (
    set "%%A=%%B"
)

rem ── Defaults (if .env is missing a key) ─────────────────────────────────────
if not defined PORT set PORT=3000
if not defined HOST set HOST=0.0.0.0

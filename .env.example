# Zenith API — copy to .env and adjust. Every default is free to run.

# API
PORT=3000
HOST=0.0.0.0

# PostgreSQL (system of record) — matches infra/docker-compose.yml
DATABASE_URL=postgres://zenith:zenith@localhost:5432/zenith

# Ollama (local open-source LLM runtime for AI Buddy)
OLLAMA_URL=http://localhost:11434

# ── AI Buddy LLM model ───────────────────────────────────────────────────────
# Recommended by hardware tier:
#   GTX 1650 / 4 GB VRAM / 8 GB RAM  →  llama3.2:3b    (fits in 2 GB VRAM, fast)
#   RTX 3060 / 8 GB VRAM             →  mistral:7b-instruct-q4_K_M
#   CPU-only / 16 GB RAM              →  llama3.2:3b    (slower but stable)
# Pull: ollama pull llama3.2:3b
LLM_MODEL=llama3.2:3b

# ── Embedding model for implicit clinical screening (CSI engine, S2 signal) ──
# nomic-embed-text: ~274 MB, runs on CPU in the background worker — no VRAM cost.
# bge-m3: ~1.2 GB, multilingual (100+ langs), needs 8 GB+ VRAM to coexist with LLM.
# The PHQ-9/GAD-7 reference descriptors are in English so nomic-embed-text works.
# Indic language detection is covered by the Keyword Sentinel (Layer 1, zero cost).
#   ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# AI Buddy provider. Default "ollama" = fully local, conversation text never
# leaves your server. For faster replies on weak hardware, any free
# OpenAI-compatible API works (provider then sees conversation text — never
# identity; crisis detection always stays local):
#   LLM_PROVIDER=openai-compat
#   LLM_API_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_API_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=ollama

# Anonymous session token signing secret — SET A SECURE RANDOM VALUE IN PRODUCTION
# Generate with: openssl rand -base64 32
# Or PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Or Node: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_TOKEN_SECRET=dev-only-secret-change-me

# Set true when serving over HTTPS (behind TLS reverse proxy like Caddy)
COOKIE_SECURE=false

# Worker
PURGE_INTERVAL_SECONDS=60
SESSION_INACTIVITY_MINUTES=10

# Whisper STT sidecar (services/inference) — voice input in every browser
STT_URL=http://127.0.0.1:8090

# ── SMTP for counsellor magic links (optional; logs to console if not set) ──────
# For demo: use Ethereal.email (fake inbox) — create at https://ethereal.email/create
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your-ethereal-user
# SMTP_PASS=your-ethereal-pass
# SMTP_FROM="Zenith <noreply@zenith.local>"
# SMTP_TLS=true

# ── Jitsi instance for anonymous video handoff ─────────────────────────────────
# Default: public meet.jit.si (free, no setup)
# Self-host for production: docker-jitsi-meet
JITSI_BASE_URL=https://meet.jit.si

# ── LLM Provider: OpenAI-compatible (optional, for faster replies) ─────────────
# LLM_PROVIDER=openai-compat
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_API_MODEL=llama-3.3-70b-versatile
# LLM_NUM_PREDICT=200
# LLM_TIMEOUT_MS=120000